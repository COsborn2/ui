{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "es2022"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "plugins": [{ "name": "next" }],
    "skipLibCheck": true
  },
  "include": ["next-env.d.ts", "app/**/*.tsx", "components/**/*.tsx", "plain/**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
