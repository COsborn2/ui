  "scripts": {
    "build": "tsc -p tsconfig.json && bun scripts/build-css.ts",
    "dev": "bun scripts/watch.ts",
    "lint": "eslint . && bun run typecheck",
    "test": "bun test tests/*.test.ts*",
    "test:package": "bun scripts/verify-package.ts",
    "test:browser": "bun scripts/verify-browser.ts",
    "prepack": "bun run build",
    "prepublishOnly": "bun scripts/check-release.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.tools.json"
